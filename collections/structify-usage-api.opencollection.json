{
  "opencollection": "1.0.0",
  "info": {
    "name": "Structify account usage API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "user_transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/user/transactions/list"
          }
        },
        {
          "info": {
            "name": "Returns usage statistics for the user.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/user/usage",
            "params": [
              {
                "name": "dataset",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns usage statistics for the user."
        }
      ]
    }
  ],
  "bundled": true
}