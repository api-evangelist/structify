{
  "opencollection": "1.0.0",
  "info": {
    "name": "Structify account wiki API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "wiki",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "list_wiki_pages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/team/:team_id/wiki",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "create_wiki_page",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/team/:team_id/wiki",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "get_wiki_page",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/team/:team_id/wiki/:slug",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "slug",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "update_wiki_page",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.structify.ai/team/:team_id/wiki/:slug",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "slug",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "delete_wiki_page",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.structify.ai/team/:team_id/wiki/:slug",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "slug",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "header"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}