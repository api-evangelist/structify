{
  "opencollection": "1.0.0",
  "info": {
    "name": "Structify account chat_templates API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "chat_templates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List active chat templates for the /chat page",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/chat/templates",
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "header"
            }
          },
          "docs": "List active chat templates for the /chat page"
        },
        {
          "info": {
            "name": "get_chat_template",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/chat/templates/:template_id",
            "params": [
              {
                "name": "template_id",
                "value": "",
                "type": "path",
                "description": "The chat template ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "header"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}