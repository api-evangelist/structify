{
  "opencollection": "1.0.0",
  "info": {
    "name": "Structify account server API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "server",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/server/version"
          },
          "docs": "Gets the version of the API server."
        }
      ]
    }
  ],
  "bundled": true
}