{
  "opencollection": "1.0.0",
  "info": {
    "name": "Structify account workflow API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "workflow",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get terminal logs for a workflow node",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/sessions/node/:node_id/logs",
            "params": [
              {
                "name": "node_id",
                "value": "",
                "type": "path",
                "description": "Workflow session node ID"
              }
            ]
          },
          "docs": "Get terminal logs for a workflow node"
        },
        {
          "info": {
            "name": "run_workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/workflow/run",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "stop_workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/workflow/stop",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "header"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}