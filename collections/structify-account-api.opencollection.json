{
  "opencollection": "1.0.0",
  "info": {
    "name": "Structify account API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "api_keys_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/user/api_keys",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "api_keys_create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/user/api_keys",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "api_keys_get",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/user/api_keys/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "API key ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "api_keys_revoke",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.structify.ai/user/api_keys/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "API key ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "Enable a source",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/user/info",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Enable a source"
        },
        {
          "info": {
            "name": "Converts a JWT (JSON Web Token) to an API token.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/user/jwt_to_api_token/:jwt",
            "params": [
              {
                "name": "jwt",
                "value": "",
                "type": "path",
                "description": "JWT to convert to API token"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "JWTs are commonly used for authentication in web applications. They contain\nencoded information about the user and are typically short-lived for security reasons.\n\nThis endpoint exists to allow clients who have authenticated via JWT (e.g., through\nSupabase) to obtain a long-lived API token. The API token can then be used\nfor subsequent requests to the API without requiring frequent re-authentication.\n\nThis conversion process enhances security by separating the authentication mechanism\n(JWT) from"
        },
        {
          "info": {
            "name": "get_onboarding_answers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/user/onboarding/answers",
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "save_onboarding_answers",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.structify.ai/user/onboarding/answers",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "Refreshes an expired or expiring session token.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/user/refresh",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint allows clients to extend their session by providing both the current\nsession token and refresh token. Upon successful refresh, a new session token is issued\nand the old session is revoked."
        },
        {
          "info": {
            "name": "Submit user onboarding survey",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/user/survey/submit",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "header"
            }
          },
          "docs": "Submit user onboarding survey"
        }
      ]
    }
  ],
  "bundled": true
}