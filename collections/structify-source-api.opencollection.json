{
  "opencollection": "1.0.0",
  "info": {
    "name": "Structify account source API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "source",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "delete_source_entity",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.structify.ai/source/entity",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "Get all sources for a given entity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/source/get_sources",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Entity ID to get sources for"
              },
              {
                "name": "property",
                "value": "",
                "type": "query",
                "description": "Optional property name to filter sources by"
              }
            ]
          },
          "docs": "Get all sources for a given entity"
        },
        {
          "info": {
            "name": "delete_source_relationship",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.structify.ai/source/relationship",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}