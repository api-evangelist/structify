          "name": "Generates code based on the provided prompt.",
          "request": {
            "name": "Generates code based on the provided prompt.",
            "description": {
              "content": "Events are streamed via WebSocket connection. This endpoint returns immediately\nafter starting the generation process.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "code",
