                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"<string>\",\n  \"chatSessionId\": \"<uuid>\",\n  \"assistantMessageId\": \"<uuid>\",\n  \"config\": {\n    \"llm_key\": \"<string>\",\n    \"max_steps\": \"<integer>\",\n    \"reminder_message\": \"<string>\",\n    \"system_prompt\": \"<string>\"\n  },\n  \"connectorIds\": [\n    \"<uuid>\",\n    \"<uuid>\"\n  ],\n  \"filePaths\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"overridePreviousMessageId\": \"<uuid>\",\n  \"triggerWorkflowExecution\": \"<boolean>\",\n  \"userMessageId\": \"<uuid>\"\n}",
