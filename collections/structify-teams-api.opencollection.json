{
  "opencollection": "1.0.0",
  "info": {
    "name": "Structify account teams API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "download_teams_file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/teams/files/:token",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "path",
                "description": "Signed download token for a Teams file."
              }
            ]
          }
        },
        {
          "info": {
            "name": "Handles Microsoft Teams Bot Framework webhook messages",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/teams/messages",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint receives activities from Teams when users message the bot.\nIt handles message activities and invoke activities (for Adaptive Card actions)."
        }
      ]
    }
  ],
  "bundled": true
}