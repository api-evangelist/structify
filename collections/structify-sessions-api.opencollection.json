{
  "opencollection": "1.0.0",
  "info": {
    "name": "Structify account sessions API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "sessions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "create_session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/sessions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "estimate_cost",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/sessions/estimate_cost",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "get_node",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/sessions/nodes/:node_id",
            "params": [
              {
                "name": "node_id",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "update_workflow_node",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.structify.ai/sessions/nodes/:node_id",
            "params": [
              {
                "name": "node_id",
                "value": "",
                "type": "path",
                "description": "Id of the workflow node to update."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "confirm_node",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/sessions/nodes/:node_id/confirm",
            "params": [
              {
                "name": "node_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "edit_workflow_node_output",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/sessions/nodes/:node_id/edit_output",
            "params": [
              {
                "name": "node_id",
                "value": "",
                "type": "path",
                "description": "Id of the workflow node whose output to edit."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "Get events from all jobs for a specific workflow node.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/sessions/nodes/:node_id/events",
            "params": [
              {
                "name": "node_id",
                "value": "",
                "type": "path",
                "description": "Id of the node to get events for."
              },
              {
                "name": "search_term",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get events from all jobs for a specific workflow node."
        },
        {
          "info": {
            "name": "get_workflow_node_output_data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/sessions/nodes/:node_id/output_data",
            "params": [
              {
                "name": "node_id",
                "value": "",
                "type": "path",
                "description": "Id of the workflow node to upload output data for."
              }
            ]
          }
        },
        {
          "info": {
            "name": "upload_workflow_node_output_data",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/sessions/nodes/:node_id/output_data",
            "params": [
              {
                "name": "node_id",
                "value": "",
                "type": "path",
                "description": "Id of the workflow node to upload output data for."
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": []
            }
          }
        },
        {
          "info": {
            "name": "get_workflow_node_progress",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/sessions/nodes/:node_id/progress",
            "params": [
              {
                "name": "node_id",
                "value": "",
                "type": "path",
                "description": "Id of the workflow node to get progress for."
              }
            ]
          }
        },
        {
          "info": {
            "name": "update_workflow_node_progress",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.structify.ai/sessions/nodes/:node_id/progress",
            "params": [
              {
                "name": "node_id",
                "value": "",
                "type": "path",
                "description": "Id of the workflow node to update progress for."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "request_node_confirmation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/sessions/nodes/:node_id/request_confirmation",
            "params": [
              {
                "name": "node_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "upload_node_visualization_output",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/sessions/nodes/:node_id/visualization_output",
            "params": [
              {
                "name": "node_id",
                "value": "",
                "type": "path",
                "description": "Id of the workflow node to upload visualization output for."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "get_workflow_dag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.structify.ai/sessions/:session_id/dag",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path",
                "description": "Id of the session to get DAG for."
              }
            ]
          }
        },
        {
          "info": {
            "name": "Finalize a workflow session DAG by creating all nodes/edges and marking it as ready",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/sessions/:session_id/dag_ready",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path",
                "description": "Workflow session ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Finalize a workflow session DAG by creating all nodes/edges and marking it as ready"
        },
        {
          "info": {
            "name": "upload_dashboard_layout",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/sessions/:session_id/dashboard_layout",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path",
                "description": "Id of the workflow session to upload dashboard layout for."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "mark_workflow_session_errored",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.structify.ai/sessions/:session_id/error",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path",
                "description": "Id of the workflow session to mark as errored."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "kill_all_jobs_for_workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/sessions/:session_id/kill_jobs",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path",
                "description": "Id of the workflow session to kill jobs for."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "trigger_workflow_review",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.structify.ai/sessions/:session_id/trigger_review",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path",
                "description": "Id of the workflow session to trigger review for."
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}